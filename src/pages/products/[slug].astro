---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const related = products.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 3);
---
<Base title={product.name} description={product.description}>
  <div class="wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/products/">Products</a><span>/</span><span>{product.name}</span></nav></div>
  <section class="wrap detail-hero"><div><div class="detail-image"><img src={product.image} alt={product.alt} /></div><p class="footnote">Catalog image for illustration; it does not identify the film installed on the vehicle.</p></div><div class="detail-copy"><span class="section-label">{product.category}</span><h1>{product.name}</h1><p class="detail-summary">{product.summary}</p><p>{product.description}</p><div class="detail-rule"></div><h2>At a glance</h2><ul class="feature-list">{product.features.map((feature: string) => <li>{feature}</li>)}</ul></div></section>
  {product.specs && <section class="section wrap detail-section"><div><span class="section-label">Catalog details</span><h2>Specifications</h2></div><div><dl class="spec-list">{product.specs.map(([label, value]: [string,string]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="footnote">Values are from the supplied catalog and are not a guarantee. Warranty terms, eligibility, product availability and specifications vary; confirm before purchase or installation.</p></div></section>}
  {product.models && <section class="section wrap detail-section"><div><span class="section-label">Catalog details</span><h2>Optical &amp; solar properties</h2><p>Compare the shades listed in the catalog.</p></div><div><div class="table-scroll"><table><thead><tr><th>Model</th><th>Visible light transmission</th><th>Interior reflection</th><th>UV rejection</th><th>IR rejection</th><th>Total solar energy rejected</th></tr></thead><tbody>{product.models.map((row: string[]) => <tr>{row.map((cell: string) => <td>{cell}</td>)}</tr>)}</tbody></table></div><p class="footnote">Catalog values are provided for comparison, not as guaranteed results. The supplied catalog does not specify all measurement conditions. Verify current product specifications and local window tint regulations before installation. The catalog lists a 10-year warranty; applicability and terms must be confirmed.</p></div></section>}
  <section class="material-band"><div class="wrap material-grid"><div><span class="section-label">Installation &amp; care</span><h2>Made to be installed with care.</h2></div><div><p>{product.category === 'Window film' ? 'The window film catalog advises not cleaning the film for at least 30 days after installation. Follow the instructions provided for the specific film and installation.' : 'The paint protection catalog recommends gentle care and avoiding abrasive brushes or cleaners. Follow the installer’s instructions for the specific film.'}</p><a class="text-link" href="/faq/">Read care guidance <span aria-hidden="true">↗</span></a></div></div></section>
  {related.length > 0 && <section class="section wrap"><div class="section-heading"><h2>More to explore</h2><a class="text-link" href="/products/">All products <span aria-hidden="true">↗</span></a></div><div class="product-grid">{related.map((item: any) => <ProductCard product={item} />)}</div></section>}
</Base>
